# Auto detect text files and perform LF normalization for VPS/Linux compatibility
* text=auto eol=lf

# Explicitly declare text files (force LF on checkout)
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.sh   text eol=lf
*.sql  text eol=lf
*.env  text eol=lf
*.gitignore text eol=lf
Dockerfile  text eol=lf
.dockerignore text eol=lf

# Binary files (no conversion)
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.svg  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
*.pdf  binary
