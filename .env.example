
# =====================================================
# Port & Networking
# =====================================================
APP_PORT=9000
PORT=3000
NODE_ENV=production

# =====================================================
# Database (PostgreSQL + pgvector)
# =====================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=brilian_ai
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/brilian_ai

# =====================================================
# Redis (BullMQ Queue)
# =====================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# =====================================================
# Local Ollama Service (LLM, Vision & Embeddings)
# =====================================================
OLLAMA_ENDPOINT=http://ollama:11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_KEEP_ALIVE=24h
OLLAMA_NUM_PARALLEL=1
OLLAMA_FLASH_ATTENTION=1
CHAT_MODEL_NAME=llama3.2:3b
VISION_MODEL_NAME=qwen2.5vl:3b
EMBEDDING_MODEL_NAME=bge-m3

# =====================================================
# Multi-Agent Cloud API Keys
# =====================================================
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# =====================================================
# Multi-Agent Models
# =====================================================
GEMINI_MODEL=gemini-2.0-flash-lite
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1024
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_MODEL=deepseek-chat

# =====================================================
# Document Processing & Chunking
# =====================================================
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# =====================================================
# Super Admin Authentication (Initial Setup)
# Email default: superadmin@brilian.ai
# Set your superadmin password here:
# =====================================================
SUPERADMIN_EMAIL=superadmin@brilian.ai
SUPERADMIN_PASSWORD="1qa2ws3ed!@#"
# =====================================================
# App Domain / URL
# =====================================================
APP_URL=https://brilian.uti.co.id

# =====================================================
# Google OAuth 2.0 Single Sign-On (SSO)
# Console: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI wajib ditambahkan di Google Console:
# - Production VPS: https://brilian.uti.co.id/api/auth/google/callback
# - Docker Host:    http://localhost:9000/api/auth/google/callback
# - Local dev:      http://localhost:3000/api/auth/google/callback
# =====================================================
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://brilian.uti.co.id/api/auth/google/callback
